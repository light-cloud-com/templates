# Copy to .env for local runs. On Light Cloud these are set for you.
PORT=8080
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# require (default): TLS on, certificate not verified. disable: local database without TLS.
DB_SSLMODE=disable
# Optional: Django's signing key. A random one is made at start when unset.
DJANGO_SECRET_KEY=
