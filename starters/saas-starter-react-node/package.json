{
  "name": "saas-starter-react-node",
  "version": "1.0.0",
  "description": "SaaS starter with React, Node.js (Express) and PostgreSQL: auth, teams, billing, admin and API keys",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.18",
    "@better-auth/stripe": "1.7.18",
    "@tanstack/react-query": "5.107.1",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.70.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "resend": "6.37.0",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
