# Copy to .env for local development. On Light Cloud, set these in the app's
# environment variables instead. Every integration below is optional: it turns
# on only when all of its variables are set.

# ---- Required ----------------------------------------------------------------

# PostgreSQL connection URL. Light Cloud sets it for you, with sslmode=require
# (TLS on, certificate not verified). Leave sslmode out for a local database without TLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Signs sessions and tokens. Light Cloud generates one. Locally any long random
# string works, e.g. the output of: openssl rand -base64 32
AUTH_SECRET=

# ---- Optional ----------------------------------------------------------------

# Port the server listens on. Light Cloud sets it for you.
PORT=8080

# Product name shown in the UI and emails.
APP_NAME=Acme

# Public URL, e.g. https://app.example.com. Leave empty to work it out from each
# request (x-forwarded-host / x-forwarded-proto). Set it once you have a custom domain.
APP_URL=

# Comma-separated emails that are platform admins (the first account ever created is one too).
ADMIN_EMAILS=

# Email through Resend. Without a key, emails (and their links) go to the server log
# and email verification is skipped.
RESEND_API_KEY=
EMAIL_FROM="Acme <onboarding@resend.dev>"

# Sign in with GitHub. Callback URL: https://<your-app>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Google. Callback URL: https://<your-app>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions. Webhook URL: https://<your-app>/api/auth/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
