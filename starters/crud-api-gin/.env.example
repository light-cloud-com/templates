PORT=8080
# release (default), debug or test
GIN_MODE=debug

# Set by Light Cloud when the app has a database. These values match the local
# database from the README (docker run ... postgres:16).
DB_HOST=localhost
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# require (default): TLS on, certificate not verified. disable: no TLS, local only.
DB_SSLMODE=disable
