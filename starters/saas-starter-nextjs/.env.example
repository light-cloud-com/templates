# Copy to .env.local for local development. On Light Cloud, set these under the app's
# Environment variables. Nothing here is NEXT_PUBLIC_, so none of it reaches the browser.

# --- Required (Light Cloud sets both for you) ---------------------------------------------

# PostgreSQL connection URL. On Light Cloud it ends with sslmode=require&uselibpqcompat=true
# (TLS on, certificate not verified). Leave sslmode out for a local database without TLS.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Signs sessions and email tokens. Any long random string: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-long-random-string

# --- Optional ------------------------------------------------------------------------------

# Public URL of the app. Leave empty to use the URL each request came in on.
# Set it once you add a custom domain, so email links never depend on request headers.
APP_URL=

# Product name shown in the header, page titles and emails.
APP_NAME=Acme

# Comma-separated emails that are platform admins (/admin), on top of the first user.
ADMIN_EMAILS=

# Email through Resend. Without a key, emails are printed to the server log instead
# and email verification is skipped.
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>

# Social sign-in. Each button appears only when both its values are set.
# Callback URLs: <APP_URL>/api/auth/callback/github and <APP_URL>/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe subscriptions. Billing switches on only when all four are set.
# Webhook endpoint: <APP_URL>/api/auth/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
